{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"portal": {
			"projectType": "application",
			"schematics": {},
			"root": "projects/portal",
			"sourceRoot": "projects/portal/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "ngx-build-plus:browser",
					"options": {
						"outputPath": "dist/portal",
						"tsConfig": "projects/portal/tsconfig.app.json",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/portal/public",
								"output": "."
							}
						],
						"styles": [
							"projects/portal/src/styles.css"
						],
						"main": "projects/portal/src/main.ts",
						"index": "projects/portal/src/index.html",
						"extraWebpackConfig": "projects/portal/webpack.config.js",
						"commonChunk": true,
						"namedChunks": false,
						"allowedCommonJsDependencies": [
							"@angular-architects/module-federation"
						]
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all",
							"extraWebpackConfig": "projects/portal/webpack.prod.config.js"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "ngx-build-plus:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "portal:build:production",
							"extraWebpackConfig": "projects/portal/webpack.prod.config.js"
						},
						"development": {
							"buildTarget": "portal:build:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4200,
						"publicHost": "http://localhost:4200",
						"extraWebpackConfig": "projects/portal/webpack.config.js"
					}
				},
				"extract-i18n": {
					"builder": "@angular/build:extract-i18n"
				},
				"test": {
					"builder": "@angular/build:karma",
					"options": {
						"tsConfig": "projects/portal/tsconfig.spec.json",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/portal/public"
							}
						],
						"styles": [
							"projects/portal/src/styles.css"
						]
					}
				}
			}
		},
		"student-info": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss"
				}
			},
			"root": "projects/student-info",
			"sourceRoot": "projects/student-info/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "ngx-build-plus:browser",
					"options": {
						"tsConfig": "projects/student-info/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/student-info/public",
								"output": "."
							}
						],
						"styles": [
							"projects/student-info/src/styles.scss"
						],
						"main": "projects/student-info/src/main.ts",
						"outputPath": "dist/student-info",
						"index": "projects/student-info/src/index.html",
						"extraWebpackConfig": "projects/student-info/webpack.config.js",
						"commonChunk": true,
						"namedChunks": true,
						"allowedCommonJsDependencies": [
							"@angular-architects/module-federation"
						]
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all",
							"extraWebpackConfig": "projects/student-info/webpack.prod.config.js"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "ngx-build-plus:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "student-info:build:production",
							"extraWebpackConfig": "projects/student-info/webpack.prod.config.js"
						},
						"development": {
							"buildTarget": "student-info:build:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4201,
						"publicHost": "http://localhost:4201",
						"extraWebpackConfig": "projects/student-info/webpack.config.js"
					}
				},
				"extract-i18n": {
					"builder": "@angular/build:extract-i18n"
				},
				"test": {
					"builder": "@angular/build:karma",
					"options": {
						"tsConfig": "projects/student-info/tsconfig.spec.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/student-info/public"
							}
						],
						"styles": [
							"projects/student-info/src/styles.scss"
						]
					}
				}
			}
		},
		"shared": {
			"projectType": "library",
			"root": "projects/shared",
			"sourceRoot": "projects/shared/src",
			"prefix": "lib",
			"architect": {
				"build": {
					"builder": "@angular/build:ng-packagr",
					"configurations": {
						"production": {
							"tsConfig": "projects/shared/tsconfig.lib.prod.json"
						},
						"development": {
							"tsConfig": "projects/shared/tsconfig.lib.json"
						}
					},
					"defaultConfiguration": "production"
				},
				"test": {
					"builder": "@angular/build:karma",
					"options": {
						"tsConfig": "projects/shared/tsconfig.spec.json"
					}
				}
			}
		}
	}
}