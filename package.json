{
	"name": "student-portal",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"dev": "node scripts/local-server.mjs",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test:all": "ng test portal --watch=false --coverage && ng test student-info --watch=false --coverage && ng test shared --watch=false --coverage",
		"test:all:watch": "ng test portal --watch=false --coverage && ng test student-info --watch=false --ui && ng test shared --watch=false --ui",
		"build:single-spa:spa-sample": "ng build spa-sample --configuration production",
		"serve:single-spa:spa-sample": "ng s --project student-info --disable-host-check --port 4201 --live-reload false"
	},
	"prettier": {
		"printWidth": 100,
		"singleQuote": true,
		"overrides": [
			{
				"files": "*.html",
				"options": {
					"parser": "angular"
				}
			}
		]
	},
	"private": true,
	"packageManager": "npm@11.7.0",
	"dependencies": {
		"@angular/animations": "^21.0.8",
		"@angular/common": "^21.0.8",
		"@angular/compiler": "^21.0.8",
		"@angular/core": "^21.0.8",
		"@angular/forms": "^21.0.8",
		"@angular/platform-browser": "^21.0.8",
		"@angular/router": "^21.0.8",
		"es-module-shims": "^2.8.0",
		"rxjs": "~7.8.2",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@angular-builders/custom-webpack": "21.0.3",
		"@angular/build": "^21.0.5",
		"@angular/cli": "^21.0.5",
		"@angular/compiler-cli": "^21.0.8",
		"@vitest/browser-playwright": "^4.0.17",
		"@vitest/coverage-v8": "^4.0.17",
		"@vitest/ui": "^4.0.17",
		"concurrently": "^9.2.1",
		"jsdom": "^27.4.0",
		"ng-packagr": "^21.0.1",
		"single-spa": "^6.0.3",
		"single-spa-angular": "^9.2.0",
		"style-loader": "^3.3.4",
		"systemjs": "^6.15.1",
		"tailwindcss": "^3.4.19 ",
		"typescript": "~5.9.3",
		"vitest": "^4.0.17"
	}
}
