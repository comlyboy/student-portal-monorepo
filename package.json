{
  "name": "student-portal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "node scripts/local-server.mjs",
    "dev:mf": "node node_modules/@angular-architects/module-federation/src/server/mf-dev-server.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
